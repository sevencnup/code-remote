<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#FFFFFF</color>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101114</item>
        <item name="android:navigationBarColor">#101114</item>
        <item name="android:windowBackground">#101114</item>
        <item name="android:colorBackground">#101114</item>
        <item name="android:colorAccent">#AABAFF</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme.Starting" parent="@style/AppTheme" />
    <style name="SidebarMenuAnimation">
        <item name="android:windowEnterAnimation">@anim/sidebar_menu_in</item>
        <item name="android:windowExitAnimation">@anim/sidebar_menu_out</item>
    </style>
</resources>
